# backend API address (change if different)
REACT_APP_API_URL=http://localhost:5000/api

# Google reCAPTCHA site key (v3 only – invisible badge)
# Register a new reCAPTCHA in the Google admin console and choose "reCAPTCHA v3".
# Paste the **site key** below; do not include the secret.
REACT_APP_RECAPTCHA_SITE_KEY=6Lc1bHksAAAAAN-tqV0B95MC2spDCYHqIl94ZLwC

# Host configuration for CRA dev server.  If this variable is empty/undefined
# the webpack dev server will auto‑populate allowedHosts with an empty string,
# causing the "options.allowedHosts[0] should be a non-empty string" error and
# the process to exit.  Create a local .env.local containing at least the
# following line before running `npm start`:
#
#   HOST=localhost
#
# (alternatively you can set it on the command line or modify the start script)
#
# ---------------------------
# Notes on reCAPTCHA
# Backend also requires a *secret* key.  Add `RECAPTCHA_SECRET=...` to your
# backend .env or Render environment variables.  When this is missing the server
# will respond with "reCAPTCHA is not properly configured".
